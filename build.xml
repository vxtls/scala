  <target
    name="docs"
    description="Generated the API for library sources"
    depends="setup.quick"
  >
    <mkdir dir="${api.lib.dir}"/>
    <quickdoc
      srcdir="${src.dir}/${lib.dir.name}"
      destdir="${api.lib.dir}"
      sourcepath=""
    >
      <classpath>
        <pathelement location="${quick.lib.dir}"/>
