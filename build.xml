<?xml version="1.0" encoding="UTF-8"?>

<project name="scala-stage1-bootstrap" default="build" basedir=".">
  <description>
    Java 8 bootstrap build for the stage1 new Scala compiler.  This build
    intentionally does not use Pico or MSIL.  Ant integration sources are
    compiled only when ant.jar is available.
  </description>

  <property environment="env"/>

  <property name="bootstrap.home" location="${basedir}/../way2scala-2.0-stage0-bootstrap"/>
  <property name="bootstrap.sources" location="${bootstrap.home}/sources"/>
  <property name="bootstrap.library.classes" location="${bootstrap.home}/objects/main/lib/scala"/>
  <property name="bootstrap.tools.classes" location="${bootstrap.home}/objects/main/lib/tools"/>
  <property name="bootstrap.fjbg.jar" location="${bootstrap.home}/lib/fjbg/fjbg.jar"/>
  <property name="bootstrap.scalac" location="${bootstrap.home}/objects/main/bin/scalac"/>

  <property name="default.java8.home" location="${user.home}/jdk/jdk-1.8.0_451.jdk/Contents/Home"/>
  <available property="default.java8.available" file="${default.java8.home}/bin/java"/>

  <condition property="bootstrap.java.home" value="${env.SCALA_JAVA_HOME}">
    <isset property="env.SCALA_JAVA_HOME"/>
  </condition>
  <condition property="bootstrap.java.home" value="${default.java8.home}">
    <and>
      <not><isset property="bootstrap.java.home"/></not>
      <isset property="default.java8.available"/>
    </and>
  </condition>
  <condition property="bootstrap.java.home" value="${env.JAVA_HOME}">
    <and>
      <not><isset property="bootstrap.java.home"/></not>
      <isset property="env.JAVA_HOME"/>
    </and>
  </condition>
  <property name="bootstrap.java.home" value="${java.home}"/>
  <property name="javac.exe" location="${bootstrap.java.home}/bin/javac"/>
  <property name="java.exe" location="${bootstrap.java.home}/bin/java"/>

  <property name="build.dir" location="${basedir}/build"/>
  <property name="build.java.classes.dir" location="${build.dir}/java-classes"/>
  <property name="build.bootstrap.classes.dir" location="${build.dir}/bootstrap-classes"/>
  <property name="build.classes.dir" location="${build.dir}/classes"/>
  <property name="build.nslib.dir" location="${build.dir}/nslib"/>
  <property name="build.lib.dir" location="${build.dir}/lib"/>
  <property name="build.meta.tool.dir" location="${build.dir}/meta-tool"/>
  <property name="bootstrap.nstools.jar.name" value="bootstrap-nstools.jar"/>
  <property name="nstools.jar.name" value="nstools.jar"/>
  <property name="bootstrap.run.classpath" value="${build.bootstrap.classes.dir}:${build.java.classes.dir}:${bootstrap.tools.classes}:${bootstrap.fjbg.jar}"/>
  <property name="distrib.version" value="1.4.0.4"/>
  <property name="copyright.notice" value="(C) 2002-06 LAMP/EPFL"/>
  <property name="distrib.unix.dir" location="${basedir}/distribs/unix"/>
  <property name="distrib.name" value="nscala"/>
  <property name="scala.exec.name" value="ns"/>
  <property name="scalac.exec.name" value="nsc"/>
  <property name="scalai.exec.name" value="nsi"/>
  <property name="scalap.exec.name" value="nsp"/>
  <property name="scalatok.exec.name" value="nsctok"/>

  <property name="ant.jar" location="${ant.home}/lib/ant.jar"/>
  <property name="java.rt.jar" location="${bootstrap.java.home}/jre/lib/rt.jar"/>
  <available property="ant.jar.available" file="${ant.jar}"/>

  <path id="bootstrap.classpath">
    <pathelement location="${build.java.classes.dir}"/>
    <pathelement location="${build.bootstrap.classes.dir}"/>
    <pathelement location="${bootstrap.library.classes}"/>
    <pathelement location="${bootstrap.tools.classes}"/>
    <pathelement location="${bootstrap.fjbg.jar}"/>
  </path>

  <path id="ant.compile.classpath">
    <path refid="bootstrap.classpath"/>
    <pathelement location="${ant.jar}"/>
  </path>

  <target name="clean">
    <delete dir="${build.dir}"/>
  </target>

  <target name="init">
    <mkdir dir="${build.java.classes.dir}"/>
    <mkdir dir="${build.bootstrap.classes.dir}"/>
    <mkdir dir="${build.classes.dir}"/>
    <mkdir dir="${build.nslib.dir}"/>
    <mkdir dir="${build.lib.dir}"/>
    <fail message="bootstrap scalac not found: ${bootstrap.scalac}">
      <condition><not><available file="${bootstrap.scalac}"/></not></condition>
    </fail>
    <fail message="bootstrap library classes not found: ${bootstrap.library.classes}">
      <condition><not><available file="${bootstrap.library.classes}"/></not></condition>
    </fail>
    <fail message="bootstrap tools classes not found: ${bootstrap.tools.classes}">
      <condition><not><available file="${bootstrap.tools.classes}"/></not></condition>
    </fail>
    <fail message="bootstrap FJBG jar not found: ${bootstrap.fjbg.jar}">
      <condition><not><available file="${bootstrap.fjbg.jar}"/></not></condition>
    </fail>
    <fail message="Java runtime jar not found: ${java.rt.jar}">
      <condition><not><available file="${java.rt.jar}"/></not></condition>
    </fail>
  </target>

  <target name="build" depends="build.final.jar"/>

  <target name="build.compiler" depends="build.java, build.nsc"/>

  <target name="build.meta.tool" depends="init">
    <mkdir dir="${build.meta.tool.dir}"/>
    <javac srcdir="${basedir}/tools/bootstrap"
           destdir="${build.meta.tool.dir}"
           source="1.8"
           target="1.8"
           fork="true"
           executable="${javac.exe}"
           includeantruntime="false"
           debug="true"/>
  </target>

  <target name="build.java" depends="init, build.meta.tool">
    <javac srcdir="${basedir}/sources/scala"
           destdir="${build.java.classes.dir}"
           source="1.8"
           target="1.8"
           fork="true"
           executable="${javac.exe}"
           includeantruntime="false"
           debug="true">
      <classpath refid="bootstrap.classpath"/>
      <include name="**/*.java"/>
    </javac>
    <java classname="bootstrap.JacoMetaPatcher" fork="true" failonerror="true">
      <classpath>
        <pathelement location="${build.meta.tool.dir}"/>
      </classpath>
      <arg value="${build.java.classes.dir}"/>
      <arg value="${basedir}/sources/scala"/>
    </java>
    <delete file="${build.java.classes.dir}/scala/Array.class"/>
    <delete file="${build.java.classes.dir}/scala/ScalaObject.class"/>
    <delete file="${build.java.classes.dir}/scala/MatchError.class"/>
    <delete file="${build.java.classes.dir}/scala/CaseClass.class"/>
  </target>

  <target name="build.nsc" depends="build.java">
    <delete dir="${build.bootstrap.classes.dir}"/>
    <mkdir dir="${build.bootstrap.classes.dir}"/>
    <exec executable="/bin/zsh" failonerror="true">
      <env key="JAVA_HOME" value="${bootstrap.java.home}"/>
      <env key="SCALA_JAVA_CMD" value="${java.exe}"/>
      <env key="SCALA_RUNTIME_SOURCES" value="${bootstrap.sources}"/>
      <env key="SCALA_RUNTIME_CLASSES" value="${bootstrap.library.classes}"/>
      <env key="SCALA_TOOLS_CLASSES" value="${bootstrap.tools.classes}"/>
      <env key="SCALA_FJBG_CLASSES" value="${bootstrap.fjbg.jar}"/>
      <arg value="-lc"/>
      <arg value="if [ -f '${ant.jar}' ]; then find sources/scala/tools/nsc sources/scala/reflect sources/scala/runtime -type f -name '*.scala' -print | xargs '${bootstrap.scalac}' -d '${build.bootstrap.classes.dir}' -classpath '${build.java.classes.dir}:${build.bootstrap.classes.dir}:${bootstrap.library.classes}:${bootstrap.tools.classes}:${bootstrap.fjbg.jar}:${ant.jar}'; else find sources/scala/tools/nsc sources/scala/reflect sources/scala/runtime -type f -name '*.scala' ! -path 'sources/scala/tools/nsc/ant/*' -print | xargs '${bootstrap.scalac}' -d '${build.bootstrap.classes.dir}' -classpath '${build.java.classes.dir}:${build.bootstrap.classes.dir}:${bootstrap.library.classes}:${bootstrap.tools.classes}:${bootstrap.fjbg.jar}'; fi"/>
    </exec>
  </target>

  <target name="patch.bootstrap.classes" depends="build.nsc">
    <java classname="bootstrap.PatchBootstrapTags" fork="true" failonerror="true">
      <classpath>
        <pathelement location="${build.meta.tool.dir}"/>
      </classpath>
      <arg value="${build.bootstrap.classes.dir}"/>
    </java>
    <java classname="bootstrap.AddImplClassInterface" fork="true" failonerror="true">
      <classpath>
        <pathelement location="${build.meta.tool.dir}"/>
      </classpath>
      <arg value="${build.bootstrap.classes.dir}"/>
    </java>
    <java classname="bootstrap.ClearFinalOnMethods" fork="true" failonerror="true">
      <classpath>
        <pathelement location="${build.meta.tool.dir}"/>
      </classpath>
      <arg value="${build.bootstrap.classes.dir}/scala/tools/nsc/symtab/Types$RefinedType$class.class"/>
      <arg value="caseElement:(I)Ljava/lang/Object;"/>
      <arg value="caseArity:()I"/>
    </java>
  </target>

  <target name="build.bootstrap.jar" depends="build.compiler, patch.bootstrap.classes">
    <jar destfile="${build.lib.dir}/${bootstrap.nstools.jar.name}">
      <fileset dir="${build.bootstrap.classes.dir}">
        <include name="scala/tools/**"/>
        <include name="scala/reflect/**"/>
        <include name="scala/runtime/**"/>
      </fileset>
      <fileset dir="${build.java.classes.dir}">
        <include name="scala/tools/**"/>
      </fileset>
      <manifest>
        <attribute name="Main-Class" value="scala.tools.nsc.Main"/>
      </manifest>
    </jar>
  </target>

  <target name="build.nslib" depends="build.bootstrap.jar">
    <delete dir="${build.nslib.dir}"/>
    <mkdir dir="${build.nslib.dir}"/>
    <exec executable="/bin/zsh" failonerror="true">
      <env key="JAVA_HOME" value="${bootstrap.java.home}"/>
      <arg value="-lc"/>
      <arg value="'${java.exe}' -Xbootclasspath/a:'${bootstrap.library.classes}' -Dscala.product=nsc -Dscala.version='${distrib.version}' -Dscala.home='${build.dir}' -Dscala.source.path='${basedir}/newsources:${basedir}/sources' -Dscala.library.source.path='${basedir}/newsources:${basedir}/sources' -Dscala.library.class.path='${build.nslib.dir}' -cp '${bootstrap.run.classpath}:${ant.jar}' scala.tools.nsc.Main -nopredefs -d '${build.nslib.dir}' -classpath '${build.java.classes.dir}:${build.nslib.dir}' -sourcepath '${basedir}/newsources:${basedir}/sources' -bootclasspath '${java.rt.jar}' '${basedir}/newsources/scala/Array.scala' '${basedir}/newsources/scala/ScalaObject.scala' '${basedir}/newsources/scala/CaseClass.scala' '${basedir}/newsources/scala/MatchError.scala' '${basedir}/sources/scala/Predef.scala' '${basedir}/sources/scala/runtime/ScalaRunTime.scala' &amp;&amp; find '${basedir}/newsources/scala' '${basedir}/sources/scala' -type f -name '*.scala' ! -path '${basedir}/sources/scala/tools/*' ! -path '${basedir}/sources/scala/dbc/*' ! -path '${basedir}/sources/scala/Predef.scala' ! -path '${basedir}/sources/scala/runtime/ScalaRunTime.scala' ! -path '${basedir}/newsources/scala/Array.scala' ! -path '${basedir}/newsources/scala/ScalaObject.scala' ! -path '${basedir}/newsources/scala/CaseClass.scala' ! -path '${basedir}/newsources/scala/MatchError.scala' -print | xargs '${java.exe}' -Xbootclasspath/a:'${bootstrap.library.classes}' -Dscala.product=nsc -Dscala.version='${distrib.version}' -Dscala.home='${build.dir}' -Dscala.source.path='${basedir}/newsources:${basedir}/sources' -Dscala.library.source.path='${basedir}/newsources:${basedir}/sources' -Dscala.library.class.path='${build.nslib.dir}' -cp '${bootstrap.run.classpath}:${ant.jar}' scala.tools.nsc.Main -d '${build.nslib.dir}' -classpath '${build.java.classes.dir}:${build.nslib.dir}' -sourcepath '${basedir}/newsources:${basedir}/sources' -bootclasspath '${java.rt.jar}'"/>
    </exec>
    <copy todir="${build.nslib.dir}">
      <fileset dir="${build.java.classes.dir}">
        <exclude name="scala/tools/**"/>
      </fileset>
    </copy>
  </target>

  <target name="build.nstools" depends="build.nslib">
    <delete dir="${build.classes.dir}"/>
    <mkdir dir="${build.classes.dir}"/>
    <exec executable="/bin/zsh" failonerror="true">
      <env key="JAVA_HOME" value="${bootstrap.java.home}"/>
      <arg value="-lc"/>
      <arg value="if [ -f '${ant.jar}' ]; then find sources/scala/tools/nsc sources/scala/reflect sources/scala/runtime -type f -name '*.scala' -print | xargs '${java.exe}' -Xbootclasspath/a:'${bootstrap.library.classes}' -Dscala.product=nsc -Dscala.version='${distrib.version}' -Dscala.home='${build.dir}' -Dscala.source.path='${basedir}/newsources:${basedir}/sources' -Dscala.library.source.path='${basedir}/newsources:${basedir}/sources' -Dscala.library.class.path='${build.nslib.dir}' -cp '${bootstrap.run.classpath}:${ant.jar}' scala.tools.nsc.Main -d '${build.classes.dir}' -classpath '${build.java.classes.dir}:${build.nslib.dir}:${build.classes.dir}:${bootstrap.fjbg.jar}:${ant.jar}' -sourcepath '${basedir}/newsources:${basedir}/sources' -bootclasspath '${java.rt.jar}'; else find sources/scala/tools/nsc sources/scala/reflect sources/scala/runtime -type f -name '*.scala' ! -path 'sources/scala/tools/nsc/ant/*' -print | xargs '${java.exe}' -Xbootclasspath/a:'${bootstrap.library.classes}' -Dscala.product=nsc -Dscala.version='${distrib.version}' -Dscala.home='${build.dir}' -Dscala.source.path='${basedir}/newsources:${basedir}/sources' -Dscala.library.source.path='${basedir}/newsources:${basedir}/sources' -Dscala.library.class.path='${build.nslib.dir}' -cp '${bootstrap.run.classpath}' scala.tools.nsc.Main -d '${build.classes.dir}' -classpath '${build.java.classes.dir}:${build.nslib.dir}:${build.classes.dir}:${bootstrap.fjbg.jar}' -sourcepath '${basedir}/newsources:${basedir}/sources' -bootclasspath '${java.rt.jar}'; fi"/>
    </exec>
  </target>

  <target name="build.final.jar" depends="build.nstools">
    <jar destfile="${build.lib.dir}/${nstools.jar.name}">
      <fileset dir="${build.classes.dir}">
        <include name="scala/tools/**"/>
        <include name="scala/reflect/**"/>
        <include name="scala/runtime/**"/>
      </fileset>
      <fileset dir="${build.java.classes.dir}">
        <include name="scala/tools/**"/>
      </fileset>
      <manifest>
        <attribute name="Main-Class" value="scala.tools.nsc.Main"/>
      </manifest>
    </jar>
  </target>

  <target name="distrib" depends="build" description="Creates a bootstrap UNIX distribution layout.">
    <property name="distrib.unix.current.dir" location="${distrib.unix.dir}/${distrib.name}-${distrib.version}"/>
    <property name="distrib.unix.scala.dir" location="${distrib.unix.current.dir}/share/${distrib.name}"/>

    <delete dir="${distrib.unix.current.dir}"/>
    <mkdir dir="${distrib.unix.scala.dir}/bin"/>
    <mkdir dir="${distrib.unix.scala.dir}/lib/scala"/>
    <mkdir dir="${distrib.unix.scala.dir}/lib/tools"/>
    <mkdir dir="${distrib.unix.current.dir}/bin"/>

    <echo file="${distrib.unix.scala.dir}/bin/.scala_wrapper"><![CDATA[#!/bin/sh

abort() {
  echo "$0:" "$@" 1>&2
  exit 1
}

SOURCE=$0
SCRIPT=`basename "$SOURCE"`
while [ -h "$SOURCE" ]; do
  LOOKUP=`ls -ld "$SOURCE"`
  TARGET=`expr "$LOOKUP" : '.*-> \(.*\)$'`
  if expr "${TARGET:-.}/" : '/.*/$' > /dev/null; then
    SOURCE=${TARGET:-.}
  else
    SOURCE=`dirname "$SOURCE"`/${TARGET:-.}
  fi
done
PREFIX=`dirname "$SOURCE"`/..
PREFIX=`cd "$PREFIX"; pwd`

JAVA_CMD="${SCALA_JAVA_CMD:-@JAVA_CMD@}"
LIB_CLASSES="$PREFIX/lib/scala"
TOOLS_CLASSES="$PREFIX/lib/tools"
FJBG_JAR="$PREFIX/lib/fjbg.jar"
TOOLS_CP="$PREFIX/lib/@NSTOOLS_JAR@:$TOOLS_CLASSES:$FJBG_JAR"
if [ -f "$PREFIX/lib/ant.jar" ]; then
  TOOLS_CP="$TOOLS_CP:$PREFIX/lib/ant.jar"
fi

export SCALA_RUNTIME_SOURCES="${SCALA_RUNTIME_SOURCES:-@RUNTIME_SOURCES@}"
export SCALA_RUNTIME_CLASSES="${SCALA_RUNTIME_CLASSES:-$LIB_CLASSES}"
export SCALA_TOOLS_CLASSES="${SCALA_TOOLS_CLASSES:-$TOOLS_CLASSES}"
export SCALA_FJBG_CLASSES="${SCALA_FJBG_CLASSES:-$FJBG_JAR}"

case "$SCRIPT" in
  @SCALA_EXEC@)
    exec "$JAVA_CMD" -Xbootclasspath/a:"$LIB_CLASSES" "$@"
    ;;
  @SCALAC_EXEC@)
    exec "$JAVA_CMD" -Xms16M -Xmx512M -Xbootclasspath/a:"$LIB_CLASSES" -Dscala.product="$SCRIPT" -Dscala.version="@VERSION@" -Dscala.home="$PREFIX" -Dscala.source.path="$SCALA_RUNTIME_SOURCES" -Dscala.library.source.path="$SCALA_RUNTIME_SOURCES" -Dscala.library.class.path="$LIB_CLASSES" -cp "$TOOLS_CP" scala.tools.nsc.Main "$@"
    ;;
  @SCALAI_EXEC@)
    exec "$JAVA_CMD" -Xms16M -Xmx512M -Xbootclasspath/a:"$LIB_CLASSES" -Dscala.product="$SCRIPT" -Dscala.version="@VERSION@" -Dscala.home="$PREFIX" -Dscala.source.path="$SCALA_RUNTIME_SOURCES" -Dscala.library.source.path="$SCALA_RUNTIME_SOURCES" -Dscala.library.class.path="$LIB_CLASSES" -cp "$TOOLS_CP" scala.tools.nsc.MainInterpreter "$@"
    ;;
  @SCALAP_EXEC@)
    exec "$JAVA_CMD" -Xms16M -Xmx512M -Xbootclasspath/a:"$LIB_CLASSES" -Dscala.product="$SCRIPT" -Dscala.version="@VERSION@" -Dscala.home="$PREFIX" -Dscala.source.path="$SCALA_RUNTIME_SOURCES" -Dscala.library.source.path="$SCALA_RUNTIME_SOURCES" -Dscala.library.class.path="$LIB_CLASSES" -cp "$TOOLS_CP" scala.tools.scalap.Main "$@"
    ;;
  @SCALATOK_EXEC@)
    exec "$JAVA_CMD" -Xms16M -Xmx512M -Xbootclasspath/a:"$LIB_CLASSES" -Dscala.product="$SCRIPT" -Dscala.version="@VERSION@" -Dscala.home="$PREFIX" -Dscala.source.path="$SCALA_RUNTIME_SOURCES" -Dscala.library.source.path="$SCALA_RUNTIME_SOURCES" -Dscala.library.class.path="$LIB_CLASSES" -cp "$TOOLS_CP" scala.tools.nsc.MainTokenMetric "$@"
    ;;
  *)
    abort "Don't know what to do for $SCRIPT."
    ;;
esac
]]></echo>
    <replace file="${distrib.unix.scala.dir}/bin/.scala_wrapper">
      <replacefilter token="@JAVA_CMD@" value="${java.exe}"/>
      <replacefilter token="@RUNTIME_SOURCES@" value="${bootstrap.sources}"/>
      <replacefilter token="@NSTOOLS_JAR@" value="${nstools.jar.name}"/>
      <replacefilter token="@VERSION@" value="${distrib.version}"/>
      <replacefilter token="@SCALA_EXEC@" value="${scala.exec.name}"/>
      <replacefilter token="@SCALAC_EXEC@" value="${scalac.exec.name}"/>
      <replacefilter token="@SCALAI_EXEC@" value="${scalai.exec.name}"/>
      <replacefilter token="@SCALAP_EXEC@" value="${scalap.exec.name}"/>
      <replacefilter token="@SCALATOK_EXEC@" value="${scalatok.exec.name}"/>
    </replace>
    <chmod file="${distrib.unix.scala.dir}/bin/.scala_wrapper" perm="ugo+rx"/>

    <copy file="${build.lib.dir}/${nstools.jar.name}" todir="${distrib.unix.scala.dir}/lib"/>
    <copy todir="${distrib.unix.scala.dir}/lib/scala">
      <fileset dir="${build.nslib.dir}"/>
    </copy>
    <copy todir="${distrib.unix.scala.dir}/lib/tools">
      <fileset dir="${build.classes.dir}">
        <include name="scala/tools/**"/>
      </fileset>
      <fileset dir="${build.java.classes.dir}">
        <include name="scala/tools/**"/>
      </fileset>
    </copy>
    <copy file="${bootstrap.fjbg.jar}" tofile="${distrib.unix.scala.dir}/lib/fjbg.jar"/>
    <copy file="${ant.jar}" tofile="${distrib.unix.scala.dir}/lib/ant.jar" failonerror="false"/>

    <symlink resource=".scala_wrapper" link="${distrib.unix.scala.dir}/bin/${scala.exec.name}" overwrite="yes"/>
    <symlink resource=".scala_wrapper" link="${distrib.unix.scala.dir}/bin/${scalac.exec.name}" overwrite="yes"/>
    <symlink resource=".scala_wrapper" link="${distrib.unix.scala.dir}/bin/${scalai.exec.name}" overwrite="yes"/>
    <symlink resource=".scala_wrapper" link="${distrib.unix.scala.dir}/bin/${scalap.exec.name}" overwrite="yes"/>
    <symlink resource=".scala_wrapper" link="${distrib.unix.scala.dir}/bin/${scalatok.exec.name}" overwrite="yes"/>

    <symlink resource="${distrib.unix.scala.dir}/bin/${scala.exec.name}" link="${distrib.unix.current.dir}/bin/${scala.exec.name}" overwrite="yes"/>
    <symlink resource="${distrib.unix.scala.dir}/bin/${scalac.exec.name}" link="${distrib.unix.current.dir}/bin/${scalac.exec.name}" overwrite="yes"/>
    <symlink resource="${distrib.unix.scala.dir}/bin/${scalai.exec.name}" link="${distrib.unix.current.dir}/bin/${scalai.exec.name}" overwrite="yes"/>
    <symlink resource="${distrib.unix.scala.dir}/bin/${scalap.exec.name}" link="${distrib.unix.current.dir}/bin/${scalap.exec.name}" overwrite="yes"/>
    <symlink resource="${distrib.unix.scala.dir}/bin/${scalatok.exec.name}" link="${distrib.unix.current.dir}/bin/${scalatok.exec.name}" overwrite="yes"/>
    <symlink resource="${distrib.unix.current.dir}" link="${distrib.unix.dir}/latest" overwrite="yes"/>
  </target>

  <target name="test" depends="distrib" description="Runs the legacy Scala test suite.">
    <exec executable="${basedir}/test/scalanstest" dir="${basedir}" failonerror="true"/>
  </target>
</project>
