<?xml version="1.0" encoding="UTF-8"?>

<project name="scala-stage5-bootstrap" default="build" basedir=".">
  <description>
    Java 8 bootstrap build for the stage5 Scala compiler. Ant integration
    sources are compiled only when ant.jar is available.
  </description>

  <property environment="env"/>

  <property name="stage1.home" location="${basedir}/../way2scala-2.0-stage4-bootstrap"/>
  <property name="stage0.home" location="${basedir}/../way2scala-2.0-stage3-bootstrap"/>

  <condition property="bootstrap.sources" value="${env.SCALA_RUNTIME_SOURCES}">
    <isset property="env.SCALA_RUNTIME_SOURCES"/>
  </condition>
  <property name="bootstrap.sources" value="${stage1.home}/src/library:${stage1.home}/src/compiler"/>

  <condition property="bootstrap.library.classes" value="${env.SCALA_RUNTIME_CLASSES}">
    <isset property="env.SCALA_RUNTIME_CLASSES"/>
  </condition>
  <property name="bootstrap.library.classes" location="${stage1.home}/build/nslib"/>

  <condition property="bootstrap.tools.classes" value="${env.SCALA_TOOLS_CLASSES}">
    <isset property="env.SCALA_TOOLS_CLASSES"/>
  </condition>
  <property name="bootstrap.tools.classes" location="${stage1.home}/build/classes"/>
  <property name="bootstrap.java.classes" location="${stage1.home}/build/java-classes"/>

  <property name="stage1.fjbg.jar" location="${stage1.home}/distribs/unix/scala-2.0-stage4-bootstrap/share/scala/lib/fjbg.jar"/>
  <property name="stage0.fjbg.jar" location="${stage0.home}/lib/fjbg/fjbg.jar"/>
  <condition property="bootstrap.fjbg.jar" value="${env.SCALA_FJBG_CLASSES}">
    <isset property="env.SCALA_FJBG_CLASSES"/>
  </condition>
  <condition property="bootstrap.fjbg.jar" value="${stage1.fjbg.jar}">
    <and>
      <not><isset property="bootstrap.fjbg.jar"/></not>
      <available file="${stage1.fjbg.jar}"/>
    </and>
  </condition>
  <property name="bootstrap.fjbg.jar" location="${stage0.fjbg.jar}"/>

  <property name="default.java8.home" location="${user.home}/jdk/jdk-1.8.0_451.jdk/Contents/Home"/>
  <available property="default.java8.available" file="${default.java8.home}/bin/java"/>
  <condition property="bootstrap.java.home" value="${env.SCALA_JAVA_HOME}">
    <isset property="env.SCALA_JAVA_HOME"/>
  </condition>
  <condition property="bootstrap.java.home" value="${default.java8.home}">
    <and>
      <not><isset property="bootstrap.java.home"/></not>
      <isset property="default.java8.available"/>
    </and>
  </condition>
  <condition property="bootstrap.java.home" value="${env.JAVA_HOME}">
    <and>
      <not><isset property="bootstrap.java.home"/></not>
      <isset property="env.JAVA_HOME"/>
    </and>
  </condition>
  <property name="bootstrap.java.home" value="${java.home}"/>
  <property name="javac.exe" location="${bootstrap.java.home}/bin/javac"/>
  <property name="java.exe" location="${bootstrap.java.home}/bin/java"/>
  <property name="java.rt.jar" location="${bootstrap.java.home}/jre/lib/rt.jar"/>

  <property name="src.dir" location="${basedir}/src"/>
  <property name="library.src.dir" location="${src.dir}/library"/>
  <property name="compiler.src.dir" location="${src.dir}/compiler"/>
  <property name="runtime.source.path" value="${library.src.dir}:${compiler.src.dir}"/>

  <property name="build.dir" location="${basedir}/build"/>
  <property name="build.java.classes.dir" location="${build.dir}/java-classes"/>
  <property name="build.bootstrap.classes.dir" location="${build.dir}/bootstrap-classes"/>
  <property name="build.classes.dir" location="${build.dir}/classes"/>
  <property name="build.nslib.dir" location="${build.dir}/nslib"/>
  <property name="build.lib.dir" location="${build.dir}/lib"/>
  <property name="build.meta.tool.dir" location="${build.dir}/meta-tool"/>

  <property name="distrib.version" value="2.0-stage5-bootstrap"/>
  <property name="copyright.notice" value="(C) 2002-06 LAMP/EPFL"/>
  <property name="bootstrap.compiler.jar.name" value="bootstrap-scala-compiler.jar"/>
  <property name="compiler.jar.name" value="scala-compiler.jar"/>
  <property name="library.jar.name" value="scala-library.jar"/>
  <property name="distrib.unix.dir" location="${basedir}/distribs/unix"/>
  <property name="distrib.name" value="scala"/>
  <property name="scala.exec.name" value="scala"/>
  <property name="scalac.exec.name" value="scalac"/>
  <property name="scalai.exec.name" value="scalai"/>
  <property name="scalatok.exec.name" value="scalatok"/>

  <property name="ant.jar" location="${ant.home}/lib/ant.jar"/>
  <available property="ant.jar.available" file="${ant.jar}"/>
  <condition property="maybe.ant.classpath" value=":${ant.jar}">
    <isset property="ant.jar.available"/>
  </condition>
  <property name="maybe.ant.classpath" value=""/>

  <path id="bootstrap.javac.classpath">
    <pathelement location="${build.java.classes.dir}"/>
    <pathelement location="${build.bootstrap.classes.dir}"/>
    <pathelement location="${bootstrap.java.classes}"/>
    <pathelement location="${bootstrap.library.classes}"/>
    <pathelement location="${bootstrap.tools.classes}"/>
    <pathelement location="${bootstrap.fjbg.jar}"/>
  </path>

  <property name="previous.compiler.classpath" value="${bootstrap.tools.classes}:${bootstrap.java.classes}:${bootstrap.library.classes}:${bootstrap.fjbg.jar}${maybe.ant.classpath}"/>
  <property name="current.compiler.classpath" value="${build.bootstrap.classes.dir}:${build.java.classes.dir}:${bootstrap.tools.classes}:${bootstrap.java.classes}:${bootstrap.fjbg.jar}${maybe.ant.classpath}"/>

  <target name="clean">
    <delete dir="${build.dir}"/>
  </target>

  <target name="init">
    <mkdir dir="${build.java.classes.dir}"/>
    <mkdir dir="${build.bootstrap.classes.dir}"/>
    <mkdir dir="${build.classes.dir}"/>
    <mkdir dir="${build.nslib.dir}"/>
    <mkdir dir="${build.lib.dir}"/>
    <fail message="bootstrap library classes not found: ${bootstrap.library.classes}">
      <condition><not><available file="${bootstrap.library.classes}"/></not></condition>
    </fail>
    <fail message="bootstrap tools classes not found: ${bootstrap.tools.classes}">
      <condition><not><available file="${bootstrap.tools.classes}"/></not></condition>
    </fail>
    <fail message="bootstrap Java classes not found: ${bootstrap.java.classes}">
      <condition><not><available file="${bootstrap.java.classes}"/></not></condition>
    </fail>
    <fail message="bootstrap FJBG jar not found: ${bootstrap.fjbg.jar}">
      <condition><not><available file="${bootstrap.fjbg.jar}"/></not></condition>
    </fail>
    <fail message="Java runtime jar not found: ${java.rt.jar}">
      <condition><not><available file="${java.rt.jar}"/></not></condition>
    </fail>
  </target>

  <target name="build" depends="build.final.jar"/>
  <target name="all" depends="build"/>
  <target name="build.compiler" depends="build.java, build.nsc"/>

  <target name="build.meta.tool" depends="init">
    <delete dir="${build.meta.tool.dir}"/>
    <mkdir dir="${build.meta.tool.dir}"/>
    <javac srcdir="${basedir}/tools/bootstrap"
           destdir="${build.meta.tool.dir}"
           source="1.8"
           target="1.8"
           fork="true"
           executable="${javac.exe}"
           includeantruntime="false"
           debug="true"/>
  </target>

  <target name="build.java" depends="init, build.meta.tool">
    <delete dir="${build.java.classes.dir}"/>
    <mkdir dir="${build.java.classes.dir}"/>
    <javac destdir="${build.java.classes.dir}"
           source="1.8"
           target="1.8"
           fork="true"
           executable="${javac.exe}"
           includeantruntime="false"
           debug="true">
      <src path="${library.src.dir}"/>
      <src path="${compiler.src.dir}"/>
      <classpath refid="bootstrap.javac.classpath"/>
      <include name="**/*.java"/>
    </javac>
    <java classname="bootstrap.JacoMetaPatcher" fork="true" failonerror="true">
      <classpath>
        <pathelement location="${build.meta.tool.dir}"/>
      </classpath>
      <arg value="${build.java.classes.dir}"/>
      <arg value="${library.src.dir}"/>
    </java>
    <java classname="bootstrap.JacoMetaPatcher" fork="true" failonerror="true">
      <classpath>
        <pathelement location="${build.meta.tool.dir}"/>
      </classpath>
      <arg value="${build.java.classes.dir}"/>
      <arg value="${compiler.src.dir}"/>
    </java>
  </target>

  <target name="build.nsc" depends="build.java">
    <delete dir="${build.bootstrap.classes.dir}"/>
    <mkdir dir="${build.bootstrap.classes.dir}"/>
    <exec executable="/bin/zsh" failonerror="true">
      <env key="JAVA_HOME" value="${bootstrap.java.home}"/>
      <arg value="-lc"/>
      <arg value="if [ -f '${ant.jar}' ]; then find src/compiler/scala/tools/nsc src/compiler/scala/tools/ant src/library/scala/reflect src/library/scala/runtime src/library/scala/Array.scala src/library/scala/NotDefinedError.scala -type f -name '*.scala' -print | xargs '${java.exe}' -Xbootclasspath/a:'${bootstrap.library.classes}' -Dscala.product='${scalac.exec.name}' -Dscala.version='${distrib.version}' -Dscala.home='${build.dir}' -Dscala.source.path='${bootstrap.sources}' -Dscala.library.source.path='${bootstrap.sources}' -Dscala.library.class.path='${bootstrap.library.classes}' -cp '${previous.compiler.classpath}' scala.tools.nsc.Main -d '${build.bootstrap.classes.dir}' -classpath '${build.java.classes.dir}:${build.bootstrap.classes.dir}:${bootstrap.library.classes}:${bootstrap.tools.classes}:${bootstrap.fjbg.jar}:${ant.jar}' -sourcepath '${bootstrap.sources}' -bootclasspath '${java.rt.jar}'; else find src/compiler/scala/tools/nsc src/library/scala/reflect src/library/scala/runtime src/library/scala/Array.scala src/library/scala/NotDefinedError.scala -type f -name '*.scala' ! -path 'src/compiler/scala/tools/nsc/ant/*' -print | xargs '${java.exe}' -Xbootclasspath/a:'${bootstrap.library.classes}' -Dscala.product='${scalac.exec.name}' -Dscala.version='${distrib.version}' -Dscala.home='${build.dir}' -Dscala.source.path='${bootstrap.sources}' -Dscala.library.source.path='${bootstrap.sources}' -Dscala.library.class.path='${bootstrap.library.classes}' -cp '${previous.compiler.classpath}' scala.tools.nsc.Main -d '${build.bootstrap.classes.dir}' -classpath '${build.java.classes.dir}:${build.bootstrap.classes.dir}:${bootstrap.library.classes}:${bootstrap.tools.classes}:${bootstrap.fjbg.jar}' -sourcepath '${bootstrap.sources}' -bootclasspath '${java.rt.jar}'; fi"/>
    </exec>
  </target>

  <target name="patch.bootstrap.classes" depends="build.nsc">
    <java classname="bootstrap.PatchBootstrapTags" fork="true" failonerror="true">
      <classpath>
        <pathelement location="${build.meta.tool.dir}"/>
      </classpath>
      <arg value="${build.bootstrap.classes.dir}"/>
    </java>
    <java classname="bootstrap.AddImplClassInterface" fork="true" failonerror="true">
      <classpath>
        <pathelement location="${build.meta.tool.dir}"/>
      </classpath>
      <arg value="${build.bootstrap.classes.dir}"/>
    </java>
    <available property="refined.impl.available"
               file="${build.bootstrap.classes.dir}/scala/tools/nsc/symtab/Types$RefinedType$class.class"/>
    <antcall target="clear.refined.impl"/>
  </target>

  <target name="clear.refined.impl" if="refined.impl.available">
    <java classname="bootstrap.ClearFinalOnMethods" fork="true" failonerror="true">
      <classpath>
        <pathelement location="${build.meta.tool.dir}"/>
      </classpath>
      <arg value="${build.bootstrap.classes.dir}/scala/tools/nsc/symtab/Types$RefinedType$class.class"/>
      <arg value="caseElement:(I)Ljava/lang/Object;"/>
      <arg value="caseArity:()I"/>
    </java>
  </target>

  <target name="build.bootstrap.jar" depends="build.compiler, patch.bootstrap.classes">
    <jar destfile="${build.lib.dir}/${bootstrap.compiler.jar.name}">
      <fileset dir="${build.bootstrap.classes.dir}">
        <include name="scala/tools/**"/>
        <include name="scala/reflect/**"/>
        <include name="scala/runtime/**"/>
      </fileset>
      <fileset dir="${build.java.classes.dir}">
        <include name="scala/tools/**"/>
      </fileset>
      <manifest>
        <attribute name="Main-Class" value="scala.tools.nsc.Main"/>
      </manifest>
    </jar>
  </target>

  <target name="build.nslib" depends="build.bootstrap.jar">
    <delete dir="${build.nslib.dir}"/>
    <mkdir dir="${build.nslib.dir}"/>
    <exec executable="/bin/zsh" failonerror="true">
      <env key="JAVA_HOME" value="${bootstrap.java.home}"/>
      <arg value="-lc"/>
      <arg value="'${java.exe}' -Xbootclasspath/a:'${bootstrap.library.classes}' -Dscala.product='${scalac.exec.name}' -Dscala.version='${distrib.version}' -Dscala.home='${build.dir}' -Dscala.source.path='${runtime.source.path}' -Dscala.library.source.path='${runtime.source.path}' -Dscala.library.class.path='${build.nslib.dir}' -cp '${current.compiler.classpath}' scala.tools.nsc.Main -nopredefs -d '${build.nslib.dir}' -classpath '${build.java.classes.dir}:${build.nslib.dir}' -sourcepath '${runtime.source.path}' -bootclasspath '${java.rt.jar}' '${library.src.dir}/scala/Array.scala' '${library.src.dir}/scala/ScalaObject.scala' '${library.src.dir}/scala/CaseClass.scala' '${library.src.dir}/scala/MatchError.scala' '${library.src.dir}/scala/Predef.scala' '${library.src.dir}/scala/runtime/ScalaRunTime.scala' &amp;&amp; find '${library.src.dir}' -type f -name '*.scala' ! -path '${library.src.dir}/scala/Predef.scala' ! -path '${library.src.dir}/scala/runtime/ScalaRunTime.scala' ! -path '${library.src.dir}/scala/Array.scala' ! -path '${library.src.dir}/scala/ScalaObject.scala' ! -path '${library.src.dir}/scala/CaseClass.scala' ! -path '${library.src.dir}/scala/MatchError.scala' -print | xargs '${java.exe}' -Xbootclasspath/a:'${bootstrap.library.classes}' -Dscala.product='${scalac.exec.name}' -Dscala.version='${distrib.version}' -Dscala.home='${build.dir}' -Dscala.source.path='${runtime.source.path}' -Dscala.library.source.path='${runtime.source.path}' -Dscala.library.class.path='${build.nslib.dir}' -cp '${current.compiler.classpath}' scala.tools.nsc.Main -d '${build.nslib.dir}' -classpath '${build.java.classes.dir}:${build.nslib.dir}' -sourcepath '${runtime.source.path}' -bootclasspath '${java.rt.jar}'"/>
    </exec>
    <copy todir="${build.nslib.dir}">
      <fileset dir="${build.java.classes.dir}">
        <exclude name="scala/tools/**"/>
      </fileset>
    </copy>
    <jar destfile="${build.lib.dir}/${library.jar.name}">
      <fileset dir="${build.nslib.dir}"/>
      <manifest>
        <attribute name="Specification-Version" value="${distrib.version}"/>
        <attribute name="Implementation-Version" value="${distrib.version}"/>
      </manifest>
    </jar>
  </target>

  <target name="build.nstools" depends="build.nslib">
    <delete dir="${build.classes.dir}"/>
    <mkdir dir="${build.classes.dir}"/>
    <exec executable="/bin/zsh" failonerror="true">
      <env key="JAVA_HOME" value="${bootstrap.java.home}"/>
      <arg value="-lc"/>
      <arg value="if [ -f '${ant.jar}' ]; then find src/compiler/scala/tools/nsc src/compiler/scala/tools/ant src/library/scala/reflect src/library/scala/runtime -type f -name '*.scala' -print | xargs '${java.exe}' -Xbootclasspath/a:'${bootstrap.library.classes}' -Dscala.product='${scalac.exec.name}' -Dscala.version='${distrib.version}' -Dscala.home='${build.dir}' -Dscala.source.path='${runtime.source.path}' -Dscala.library.source.path='${runtime.source.path}' -Dscala.library.class.path='${build.nslib.dir}' -cp '${current.compiler.classpath}' scala.tools.nsc.Main -d '${build.classes.dir}' -classpath '${build.java.classes.dir}:${build.nslib.dir}:${build.classes.dir}:${bootstrap.fjbg.jar}:${ant.jar}' -sourcepath '${runtime.source.path}' -bootclasspath '${java.rt.jar}'; else find src/compiler/scala/tools/nsc src/library/scala/reflect src/library/scala/runtime -type f -name '*.scala' ! -path 'src/compiler/scala/tools/nsc/ant/*' -print | xargs '${java.exe}' -Xbootclasspath/a:'${bootstrap.library.classes}' -Dscala.product='${scalac.exec.name}' -Dscala.version='${distrib.version}' -Dscala.home='${build.dir}' -Dscala.source.path='${runtime.source.path}' -Dscala.library.source.path='${runtime.source.path}' -Dscala.library.class.path='${build.nslib.dir}' -cp '${current.compiler.classpath}' scala.tools.nsc.Main -d '${build.classes.dir}' -classpath '${build.java.classes.dir}:${build.nslib.dir}:${build.classes.dir}:${bootstrap.fjbg.jar}' -sourcepath '${runtime.source.path}' -bootclasspath '${java.rt.jar}'; fi"/>
    </exec>
  </target>

  <target name="build.final.jar" depends="build.nstools">
    <jar destfile="${build.lib.dir}/${compiler.jar.name}">
      <fileset dir="${build.classes.dir}">
        <include name="scala/tools/**"/>
        <include name="scala/reflect/**"/>
        <include name="scala/runtime/**"/>
      </fileset>
      <fileset dir="${build.java.classes.dir}">
        <include name="scala/tools/**"/>
      </fileset>
      <manifest>
        <attribute name="Main-Class" value="scala.tools.nsc.Main"/>
        <attribute name="Specification-Version" value="${distrib.version}"/>
        <attribute name="Implementation-Version" value="${distrib.version}"/>
      </manifest>
    </jar>
  </target>

  <target name="distrib" depends="build" description="Creates a bootstrap UNIX distribution layout.">
    <property name="distrib.unix.current.dir" location="${distrib.unix.dir}/${distrib.name}-${distrib.version}"/>
    <property name="distrib.unix.scala.dir" location="${distrib.unix.current.dir}/share/${distrib.name}"/>

    <delete dir="${distrib.unix.current.dir}"/>
    <mkdir dir="${distrib.unix.scala.dir}/bin"/>
    <mkdir dir="${distrib.unix.scala.dir}/lib/scala"/>
    <mkdir dir="${distrib.unix.scala.dir}/lib/tools"/>
    <mkdir dir="${distrib.unix.current.dir}/bin"/>

    <copy file="${src.dir}/exec/nscala.unix.tmpl"
          tofile="${distrib.unix.scala.dir}/bin/.scala_wrapper">
      <filterset>
        <filter token="COPYRIGHT" value="${copyright.notice}"/>
        <filter token="VERSION" value="${distrib.version}"/>
        <filter token="JAVA_CMD" value="${java.exe}"/>
        <filter token="TOOLS_CPATH" value="${distrib.unix.scala.dir}/lib/${compiler.jar.name}:${distrib.unix.scala.dir}/lib/tools:${distrib.unix.scala.dir}/lib/fjbg.jar:${distrib.unix.scala.dir}/lib/scala"/>
        <filter token="LIB_CPATH" value="${distrib.unix.scala.dir}/lib/scala"/>
        <filter token="SCALA" value="${scala.exec.name}"/>
        <filter token="SCALAC" value="${scalac.exec.name}"/>
        <filter token="SCALAI" value="${scalai.exec.name}"/>
        <filter token="SCALAP" value="scalap"/>
        <filter token="SCALATOK" value="${scalatok.exec.name}"/>
      </filterset>
    </copy>
    <chmod file="${distrib.unix.scala.dir}/bin/.scala_wrapper" perm="ugo+rx"/>

    <copy file="${build.lib.dir}/${compiler.jar.name}" todir="${distrib.unix.scala.dir}/lib"/>
    <copy todir="${distrib.unix.scala.dir}/lib/scala">
      <fileset dir="${build.nslib.dir}"/>
    </copy>
    <copy todir="${distrib.unix.scala.dir}/lib/tools">
      <fileset dir="${build.classes.dir}">
        <include name="scala/tools/**"/>
      </fileset>
      <fileset dir="${build.java.classes.dir}">
        <include name="scala/tools/**"/>
      </fileset>
    </copy>
    <copy file="${bootstrap.fjbg.jar}" tofile="${distrib.unix.scala.dir}/lib/fjbg.jar"/>
    <copy file="${ant.jar}" tofile="${distrib.unix.scala.dir}/lib/ant.jar" failonerror="false"/>

    <symlink resource=".scala_wrapper" link="${distrib.unix.scala.dir}/bin/${scala.exec.name}" overwrite="yes"/>
    <symlink resource=".scala_wrapper" link="${distrib.unix.scala.dir}/bin/${scalac.exec.name}" overwrite="yes"/>
    <symlink resource=".scala_wrapper" link="${distrib.unix.scala.dir}/bin/${scalai.exec.name}" overwrite="yes"/>
    <symlink resource=".scala_wrapper" link="${distrib.unix.scala.dir}/bin/${scalatok.exec.name}" overwrite="yes"/>

    <symlink resource="${distrib.unix.scala.dir}/bin/${scala.exec.name}" link="${distrib.unix.current.dir}/bin/${scala.exec.name}" overwrite="yes"/>
    <symlink resource="${distrib.unix.scala.dir}/bin/${scalac.exec.name}" link="${distrib.unix.current.dir}/bin/${scalac.exec.name}" overwrite="yes"/>
    <symlink resource="${distrib.unix.scala.dir}/bin/${scalai.exec.name}" link="${distrib.unix.current.dir}/bin/${scalai.exec.name}" overwrite="yes"/>
    <symlink resource="${distrib.unix.scala.dir}/bin/${scalatok.exec.name}" link="${distrib.unix.current.dir}/bin/${scalatok.exec.name}" overwrite="yes"/>
    <symlink resource="${distrib.unix.current.dir}" link="${distrib.unix.dir}/latest" overwrite="yes"/>
  </target>

  <target name="test" depends="distrib" description="Runs the legacy Scala test suite.">
    <exec executable="${basedir}/test/scalanstest" dir="${basedir}" failonerror="true"/>
  </target>
</project>
